{
  "name": "@ai-agent-manager/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@ai-agent-manager/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "tsx --test tests/database.test.ts",
    "db:smoke": "tsx --test tests/database.test.ts",
    "db:init": "tsx scripts/init.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:kit": "tsx scripts/init.ts && drizzle-kit migrate --config=drizzle.config.ts"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "0.45.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7",
    "@types/node": "^26.6.6",
    "drizzle-kit": "0.31.11",
    "tsx": "^4.23.15",
    "typescript": "6.0.3"
  }
}
