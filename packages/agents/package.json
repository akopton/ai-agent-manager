{
  "name": "@ai-agent-manager/agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@ai-agent-manager/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./diagnostics": {
      "@ai-agent-manager/source": "./src/diagnostics.ts",
      "types": "./dist/diagnostics.d.ts",
      "import": "./dist/diagnostics.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "tsx --conditions=@ai-agent-manager/source --test tests/*.test.ts"
  },
  "dependencies": {
    "@ai-agent-manager/core": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "6.0.3"
  }
}
