{
  "name": "ai-agent-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first orchestration for coding agents",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:apps": "pnpm --recursive --parallel --if-present run dev",
    "build": "pnpm --recursive --if-present run build",
    "typecheck": "tsc --noEmit && pnpm --recursive --if-present run typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @ai-agent-manager/git run build && pnpm --recursive --if-present run test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24 <25"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^26.6.6",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10",
    "globals": "^16",
    "prettier": "^3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
