{
  "name": "ai-agent-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first orchestration for coding agents",
  "scripts": {
    "dev": "pnpm --recursive --parallel --if-present run dev",
    "typecheck": "tsc --noEmit && pnpm --recursive --if-present run typecheck",
    "lint": "pnpm --recursive --if-present run lint",
    "test": "pnpm --recursive --if-present run test"
  },
  "keywords": [],
